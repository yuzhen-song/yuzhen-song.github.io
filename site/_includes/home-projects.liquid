{% assign selected_projects = site.projects | where_exp: 'project', 'project.home_order' | sort: 'home_order' %}
<div class="home-project-list">
  {% for project in selected_projects %}
    {% if project %}
      <article class="home-project-item">
        <a class="home-project-image" href="{{ project.url | relative_url }}">
          <img src="{{ project.img | relative_url }}" alt="{{ project.title | escape }}" loading="lazy">
        </a>
        <div>
          <h3>
            <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
          </h3>
          <p>{{ project.description }}</p>
          {% if project.links %}
            <p class="home-project-links">
              {% for link in project.links %}
                <a href="{{ link.url | relative_url }}">[{{ link.name }}]</a>
              {% endfor %}
            </p>
          {% endif %}
        </div>
      </article>
    {% endif %}
  {% endfor %}
</div>
